# ==========================================================================
# UrbanReport - Plantilla de variables de entorno
# ==========================================================================
# Copia este archivo como ".env" (sin el .example) y rellena los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/Mac:             cp .env.example .env
# ==========================================================================

# ── Django ──
# Clave secreta. En local puedes dejar la de desarrollo; para la demo/produccion
# genera una propia (python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me-in-production

# DEBUG: 'true' en desarrollo, 'false' en la demo publica.
DJANGO_DEBUG=true

# Hosts permitidos (separados por coma). En local puede ir vacio.
# Para una demo en un dominio/IP publica, agregalo aqui. Ej:
# DJANGO_ALLOWED_HOSTS=miapp.onrender.com,192.168.1.50
DJANGO_ALLOWED_HOSTS=

# ── Base de datos compartida (Supabase / PostgreSQL) ──
# Toma estos datos del dashboard de Supabase:
#   Project Settings  ->  Database  ->  Connection parameters / Connection string
#
# IMPORTANTE: para que la base sea COMPARTIDA, tu companero y tu deben usar
# EXACTAMENTE los mismos valores (apuntando al mismo proyecto de Supabase).
#
# Si DB_NAME esta vacio, el proyecto usa SQLite local (db.sqlite3) en su lugar.
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=TU_PASSWORD_DE_SUPABASE
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
