# ==========================================================================
# UrbanReport - Variables de entorno (PLANTILLA)
# ==========================================================================
# Copia este archivo a ".env" y completa los valores reales.
# El archivo .env real está en .gitignore y NUNCA debe subirse a GitHub.
#
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ==========================================================================

# ── Seguridad de Django ──
# Clave secreta. Genera una nueva para producción, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-unica

# Modo debug: True solo en desarrollo. En producción debe ser False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma (sin espacios). Ej: midominio.com,www.midominio.com
# En desarrollo con DEBUG=True puedes dejarlo vacío (usa localhost por defecto).
DJANGO_ALLOWED_HOSTS=

# ── Base de datos ──
# Si NO defines DB_NAME, el proyecto usa SQLite (db.sqlite3) automáticamente.
# Para usar PostgreSQL, completa las siguientes variables:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
