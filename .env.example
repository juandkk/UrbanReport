# ==========================================================================
# UrbanReport - Plantilla de variables de entorno
# ==========================================================================
# Copia este archivo como ".env" (sin el .example) y rellena los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/Mac:             cp .env.example .env
# ==========================================================================

# ── Django ──
# Clave secreta. En local puedes dejar la de desarrollo; para la demo/produccion
# genera una propia (python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me-in-production

# DEBUG: 'true' en desarrollo, 'false' en la demo publica.
DJANGO_DEBUG=true

# Hosts permitidos (separados por coma). En local puede ir vacio.
# Para una demo en un dominio/IP publica, agregalo aqui. Ej:
# DJANGO_ALLOWED_HOSTS=miapp.onrender.com,192.168.1.50
DJANGO_ALLOWED_HOSTS=

# ── Base de datos compartida (Supabase / PostgreSQL) ──
# Toma estos datos del dashboard de Supabase:
#   Project Settings  ->  Database  ->  Connection parameters / Connection string
#
# IMPORTANTE: para que la base sea COMPARTIDA, tu companero y tu deben usar
# EXACTAMENTE los mismos valores (apuntando al mismo proyecto de Supabase).
#
# Si DB_NAME esta vacio, el proyecto usa SQLite local (db.sqlite3) en su lugar.
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=TU_PASSWORD_DE_SUPABASE
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543

# ── Almacenamiento de imagenes compartido (Supabase Storage / S3) ──
# Para que las fotos de reportes y avatares se COMPARTAN (igual que la base),
# se guardan en un bucket de Supabase Storage en vez del disco local.
#
# Como obtenerlos en el dashboard de Supabase:
#   1. Storage -> crea un bucket llamado "media" y marcalo como PUBLIC.
#   2. Project Settings -> Storage (o Data API) -> seccion "S3 Connection":
#        - Endpoint   -> SUPABASE_S3_ENDPOINT
#        - Region     -> SUPABASE_S3_REGION
#   3. En esa misma seccion, "S3 Access Keys" -> genera una llave:
#        - Access key -> SUPABASE_S3_ACCESS_KEY
#        - Secret key -> SUPABASE_S3_SECRET_KEY
#
# Deja estas variables VACIAS para usar almacenamiento local (las imagenes
# NO se compartiran, pero el proyecto funciona igual).
#
# Al igual que la base, tu companero y tu deben usar los MISMOS valores.
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1

# ── Inicio de sesion con Google / Facebook (RF-015, SSO OAuth 2.0) ──
# Si estas variables estan vacias, los botones aparecen deshabilitados y el
# login social no funciona (el resto del sistema sigue igual).
#
# GOOGLE  -> https://console.cloud.google.com/  ->  APIs y servicios  ->
#   Credenciales  ->  Crear credenciales  ->  ID de cliente de OAuth  ->
#   Tipo "Aplicacion web".
#   Origenes JS autorizados:   http://127.0.0.1:8000
#   URI de redireccionamiento: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
#
# FACEBOOK -> https://developers.facebook.com/  ->  crea una app  ->
#   producto "Inicio de sesion con Facebook"  ->  Configuracion.
#   URI de redireccionamiento OAuth validos:
#     http://127.0.0.1:8000/accounts/facebook/login/callback/
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_SECRET=

# ── Correos ──
# La recuperacion de contrasena NO envia correos reales (el plan free de Render
# bloquea el SMTP saliente): simula el envio mostrando el enlace de restablecimiento
# en pantalla. No se necesitan variables de correo.
